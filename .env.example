# Copy to .env.local and fill in. .env.local is private and must not be shared.
# Zetaris JDBC endpoint (the local Docker install listens on port 10000)
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# Your Zetaris login
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Full path to the Zetaris JDBC driver JAR (in the Zetaris platform folder, under jdbc/)
ZETARIS_JDBC_JAR=
# Optional, agent step: Meterless Nightshift (defaults are found automatically)
# METERLESS_BASE_URL=http://127.0.0.1:8088
# METERLESS_TOKEN_FILE=/Users/<you>/Library/Application Support/ai.meterless.runtime/proxy-token
# Optional, agent limits per cell line (run_pipeline.sh --examine / --keep override them)
# MAX_EXAMINE=10
# TARGET_KEEP=3
# SYNERGY_ACCEPT=include_mechanistic
# Optional: the semantic layer to read (default shown)
# DRUG_SYNERGY_USL=lightning.metastore.drug_synergy.drug_synergy
# The page server runs ./run_pipeline.sh <CELL> when a page runs a cell line without agent results (1), or not (0).
AGENT_ON_SUBMIT=1
# The hackathon data folder; the dashboard reads the model's modalities from its *Modalities folders.
HACKATHON_DATA_DIR=data/Hackathon_data
# The model Nightshift routes the agent's calls to (empty: meterless/auto, Nightshift decides).
METERLESS_MODEL=
# Longest reply the agent asks Nightshift for (tokens); Nightshift's own default (2,048) cuts answers off.
METERLESS_MAX_TOKENS=8000
# How long one LLM call may take before it is abandoned (ms).
METERLESS_TIMEOUT_MS=420000
